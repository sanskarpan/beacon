FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /beacon-server ./cmd/beacon-server

FROM alpine:3.19
RUN apk add --no-cache wget ca-certificates
COPY --from=build /beacon-server /usr/local/bin/beacon-server
EXPOSE 8500 8600 8502
ENTRYPOINT ["beacon-server"]
