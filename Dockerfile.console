FROM oven/bun:1 AS build
WORKDIR /app
COPY console/package.json console/bun.lock* ./
RUN bun install --frozen-lockfile
COPY console/ .
RUN bun run build

FROM nginx:alpine
RUN apk add --no-cache gettext \
    && adduser -D -u 10001 beacon \
    && mkdir -p /var/cache/nginx/client_temp /var/run/nginx /var/log/nginx /etc/nginx/conf.d \
    && chown -R beacon:beacon /var/cache/nginx /var/run/nginx /var/log/nginx /etc/nginx/conf.d \
    && sed -i 's#^pid .*#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY console/nginx.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 3000
USER beacon
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD wget -q --spider http://localhost:3000/health || wget -q --spider http://localhost:3000/ || exit 1
